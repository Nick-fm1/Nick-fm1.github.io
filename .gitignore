# Lista blanca: este repositorio es el sitio público (GitHub Pages).
# Se ignora TODO por defecto y solo se publica lo que el sitio necesita.
# Para publicar un archivo nuevo hay que añadirlo aquí a propósito.
/*

# Sitio
!/index.html
!/styles.css
!/script.js
!/og-image.png
!/fonts/

# SEO
!/robots.txt
!/sitemap.xml

# Documentación pública
!/README.md
!/guia-ardo-marketing.md

# Configuración de git
!/.gitignore
!/.gitattributes

# Aunque estén dentro de una carpeta permitida, nunca publicar:
.env*
*.log
.DS_Store
Thumbs.db
